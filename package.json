{
  "name": "pi-nice-theme",
  "version": "1.1.0",
  "description": "Static Pi theme with the exact user-saved pi-nice-theme palette.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gee666/pi-nice-theme.git"
  },
  "keywords": [
    "pi-package",
    "pi-theme"
  ],
  "files": [
    "themes",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "pretest": "npm run test:pi",
    "test": "npm run test:unit",
    "test:unit": "node --test",
    "test:pi": "node scripts/validate-pi.mjs",
    "check": "node --check scripts/validate-pi.mjs && node --check tests/theme.test.mjs"
  },
  "pi": {
    "themes": [
      "./themes/pi-nice-theme.json"
    ]
  }
}
